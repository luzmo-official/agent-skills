# Luzmo API credentials for ONE customer. Fill in locally; never paste these in chat.
# In Luzmo, open Settings > API Tokens (for example https://app.luzmo.com/settings/api-tokens).
# Host: copy the "API host URL" shown under "API information" on that page.
# Key and token: click "Create API token" and copy both right away (the token is shown only once).
# Editing rights are only needed for the final, approved update step.
LUZMO_API_HOST=https://api.luzmo.com
LUZMO_API_KEY=<paste-api-key-here>
LUZMO_API_TOKEN=<paste-api-token-here>

# Optional, not secret: the address you log in to Luzmo at (for example https://app.luzmo.com or your own
# domain). Used only for the "Open in Luzmo" links in the generated review page, which take you to the
# datasets, agents, rules and dashboards it mentions. When empty, the review guesses it from LUZMO_API_HOST
# (api.… → app.…). You can also change it in the field at the top of the review page.
LUZMO_APP_HOST=

# Only when asked: one end user's Embed key/token pair (usually created by your developer),
# to ask IQ test questions as that end user, or for tenant-specific profiling.
# With an organization owner's API token above, the toolkit can also fill these in for you,
# after you confirm the end user's details.
LUZMO_EMBED_KEY=
LUZMO_EMBED_TOKEN=
